{
  "manifest_version": 2,
  "name": "JP Word Tracker",
  "version": "3.0",
  "description": "Highlights Japanese words/phrases you've already seen (dictionary-based longest match). Hover + Shift to add/increment.",
  "browser_specific_settings": {
    "gecko": {
      "id": "jp-word-tracker@example.local",
      "strict_min_version": "140.0"
    }
  },
  "permissions": ["storage", "<all_urls>"],
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "browser_action": {
    "default_title": "JP Word Tracker: word list",
    "default_icon": "icon.svg"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "css": ["highlight.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
